
{%- style -%}
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; z-index: 1; position: relative }
    .business-listing .business-listing--item { background: #fff; padding: 2.5rem; border-radius: 8px; box-shadow: 0 0 2px 0 #ddd; display: flex; gap: 25px; align-items: center }
    .business-listing .business-listing--item + .business-listing--item { margin-top: 25px }
    .business-listing .bli--image { max-width: 225px; width: 225px; overflow: hidden; border-radius: 8px; height: 225px }
    .business-listing .bli--image img { object-fit: cover; height: 100%; width: 100% }
    .business-listing .bli--content { width: 100% }
    .business-listing .bli--content .bli-sale-listing { display: flex; align-items: center; gap: 20px; position: relative }
    .business-listing .bli-sale-listing label { background: #fff; color: #000; height: 31px; padding: 0 7px; border-radius: 3px; border: 1px solid #000 }
    .business-listing .bli-sale-listing a { text-transform: uppercase; position: absolute; right: 0; top: 0 }
    .business-listing .bli-sale-listing span { color: rgb(236,72,61); display: block; font-size: 26px; font-weight: 600 }
    .business-listing .bli-sale-listing span:before { content: ''; width: 10px; height: 10px; background: rgba(236,72,61); display: inline-block; vertical-align: middle; border-radius: 50%; margin-right: 2px }
    .business-listing .bli-sale-listing .status--sale { color: #028F0F }
    .business-listing .bli-sale-listing .status--sale:before { background: #028F0F }
    .business-listing .bli-sale-listing .status--pending { color: #FEC746 }
    .business-listing .bli-sale-listing .status--pending:before { background: #FEC746 }
    .business-listing h2 { font-size: 28px; margin: 15px auto }
    .business-listing h2 a { color: inherit; text-decoration: none }
    .business-listing .bli-description { line-height: 1.4 }
    .business-listing .bli-features { display: flex; justify-content: space-between }
    .business-listing .bli-features p { color: #555; font-size: 16px; margin: 15px 0 0 0; line-height: 1.4 }
    .business-listing .bli-features p span { display: block; font-weight: 600; color: #000; font-size: 18px }
  
    @media screen and ( min-width: 750px ) {
        .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px }
    }
    @media screen and ( max-width: 989px ) {
        .business-listing .business-listing--item { display: block }
        .business-listing .bli-features p { min-width: 20% }
        .business-listing .bli--image { margin-bottom: 30px }
        .business-listing .bli-features p { width: calc(50% - 5px); display: inline-block }
        .business-listing .bli-features p:not(.show-in-mobile) { display: none }
        .business-listing .bli--content .button { width: 100%; margin-top: 20px }
    }
    @media screen and ( max-width: 749px ) {
        .business-listing h2 { font-size: 24px }
        .business-listing .bli--image { max-width: 100% }
        .business-listing .bli-sale-listing span { font-size: 20px; margin-top: -4px }
        .business-listing .bli-features { display: block }
    }
{%- endstyle -%}

<section class="business-listing section-{{ section.id }}-padding">
    <div class="isolate page-width">
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {%- when 'listing' -%}
                {%  assign list = pages[block.settings.listing_page] %}
                <div class="business-listing--item">
                    <div class="bli--image desktop--only"><a href="{{ list.url }}"><img src="{{ list.metafields.custom.listing_image | file_url }}"></a></div>
                    <div class="bli--content">
                        <div class="bli-sale-listing">
                            <label>{{ list.metafields.custom.type }}</label>
                            <span class="status--{{ block.settings.status }}">
                                {% if block.settings.status == 'sale' %}For Sale{% elsif block.settings.status == 'pending' %}Sale Pending{% else %}Sold{% endif %}
                            </span>
                            <a href="{{ list.url }}" class="button desktop--only">View Listing ›</a>
                        </div>
                        <h2><a href="{{ list.url }}">{{ list.title }}</a></h2>
                        <div class="bli-description">{{ list.metafields.custom.overview | strip_html | metafield_tag | truncate: 258 }}</div>
                        <div class="bli-features">
                            <p class="show-in-mobile">Asking Price <span>{{ list.metafields.custom.asking_price }}</span></p>
                            <p>Monthly Revenue <span>{{ list.metafields.custom.monthly_revenue }}</span></p>
                            <p>Monthly Net Profit <span>{{ list.metafields.custom.monthly_net_profit }}</span></p>
                            <p>Monthly Multiplier <span>{{ list.metafields.custom.monthly_multiplier }}</span></p>
                            <p class="show-in-mobile">Established <span>{{ list.metafields.custom.business_created }}</span></p>
                        </div>
                        <div class="mobile--only"><a href="{{ list.url }}" class="button">View Listing ›</a></div>
                    </div>
                </div>
            {% endcase %}
        {% endfor %}
    </div>
</section>

{% schema %}
    {
        "name": "Business Listing",
        "settings": [
            {
                "type": "header",
                "content": "Section Padding"
            },
            {
                "type": "range",
                "id": "padding_top",
                "min": 0,
                "max": 100,
                "step": 4,
                "unit": "px",
                "label": "Top padding",
                "default": 40
            },
            {
                "type": "range",
                "id": "padding_bottom",
                "min": 0,
                "max": 100,
                "step": 4,
                "unit": "px",
                "label": "Bottom padding",
                "default": 40
            }
        ],
        "max_blocks": 5,
        "blocks": [
            {
                "type": "listing",
                "name": "Listing Page",
                "settings": [
                    {
                        "type": "page",
                        "id": "listing_page",
                        "label": "Select Page"
                    },
                    {
                        "type": "select",
                        "id": "status",
                        "options": [
                            {
                                "value": "sale",
                                "label": "For Sale"
                            },
                            {
                                "value": "pending",
                                "label": "Sale Pending"
                            },
                            {
                                "value": "sold",
                                "label": "Sold"
                            }
                        ],
                        "default": "sale",
                        "label": "Status"
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "Business Listing",
                "category": "page"
            }
        ]
    }
{% endschema %}