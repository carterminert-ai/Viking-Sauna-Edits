<style>
  .compare-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-family: var(--font-body-family);
    font-size: 0.95rem;
  }
  .compare-table th,
  .compare-table td {
    padding: 14px 18px;
    text-align: center;
    border-bottom: 1px solid #ebebeb;
  }
  .compare-table th {
    font-family: var(--font-heading-family);
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a18;
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .compare-table td:first-child,
  .compare-table th:first-child {
    text-align: left;
    font-weight: 600;
    color: #888;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    width: 18%;
  }
  .compare-table tr:last-child td {
    border-bottom: none;
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .compare-table tr:hover td {
    background: #fafafa;
  }
  .compare-col-popular {
    background: #fffbf3;
    border-left: 2px solid #c9a45a;
    border-right: 2px solid #c9a45a;
  }
  .compare-col-popular th {
    border-top: 2px solid #c9a45a;
  }
  .compare-col-popular tr:last-child td {
    border-bottom: 2px solid #c9a45a;
  }
  .compare-popular-badge {
    display: inline-block;
    background: #c9a45a;
    color: #1a1a18;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 3px 10px;
    border-radius: 50px;
    margin-bottom: 6px;
    text-transform: uppercase;
  }
  .compare-btn {
    display: inline-block;
    background: #1a1a18;
    color: #ffffff !important;
    border-radius: 50px;
    padding: 10px 22px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: background 0.15s;
  }
  .compare-btn:hover {
    background: #c9a45a;
    color: #1a1a18 !important;
  }
  .compare-btn-popular {
    background: #c9a45a;
    color: #1a1a18 !important;
  }
  .compare-btn-popular:hover {
    background: #1a1a18;
    color: #ffffff !important;
  }
  .compare-check { color: #c9a45a; font-size: 1.1rem; }
  .compare-dash  { color: #ccc; }
</style>

<section style="background:#ffffff; padding:72px 20px; border-top:1px solid #ebebeb;">
  <div style="max-width:1100px; margin:0 auto;">

    <div style="text-align:center; margin-bottom:48px;">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(201,164,90,0.12); border:1.5px solid #c9a45a; border-radius:50px; padding:5px 16px; font-size:0.78rem; font-weight:700; letter-spacing:0.1em; color:#8a6e35; margin-bottom:16px;">COMPARE MODELS</div>
      <h2 style="font-size:2rem; color:#1a1a18; margin:0 0 10px;">Find Your Perfect Sauna</h2>
      <p style="color:#777; font-size:0.97rem; margin:0; line-height:1.7;">All models are built with all-natural cedar and handcrafted in Boise, Idaho.</p>
    </div>

    <div class="compare-wrap">
      <table class="compare-table">
        <thead>
          <tr>
            <th></th>
            <th>
              <div style="font-size:1.3rem; margin-bottom:4px;">Leif</div>
              <div style="font-size:0.8rem; color:#999; font-weight:400;">2-Person Pod</div>
            </th>
            <th class="compare-col-popular">
              <div class="compare-popular-badge">Most Popular</div>
              <div style="font-size:1.3rem; margin-bottom:4px;">Ragnar</div>
              <div style="font-size:0.8rem; color:#999; font-weight:400;">4-Person Barrel</div>
            </th>
            <th>
              <div style="font-size:1.3rem; margin-bottom:4px;">Erik</div>
              <div style="font-size:0.8rem; color:#999; font-weight:400;">4-Person Pod</div>
            </th>
            <th>
              <div style="font-size:1.3rem; margin-bottom:4px;">Bjorn</div>
              <div style="font-size:0.8rem; color:#999; font-weight:400;">6-Person Cabin</div>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Capacity</td>
            <td>1–2 people</td>
            <td class="compare-col-popular">2–4 people</td>
            <td>2–4 people</td>
            <td>4–6 people</td>
          </tr>
          <tr>
            <td>Style</td>
            <td>Cabin / Pod</td>
            <td class="compare-col-popular">Classic Barrel</td>
            <td>Cabin / Pod</td>
            <td>Large Cabin</td>
          </tr>
          <tr>
            <td>Heats Up</td>
            <td>~25 min</td>
            <td class="compare-col-popular">~20 min</td>
            <td>~35 min</td>
            <td>~45 min</td>
          </tr>
          <tr>
            <td>Indoor Use</td>
            <td><span class="compare-check">✓</span></td>
            <td class="compare-col-popular"><span class="compare-check">✓</span></td>
            <td><span class="compare-check">✓</span></td>
            <td><span class="compare-dash">—</span></td>
          </tr>
          <tr>
            <td>Best For</td>
            <td>Solo use &amp; couples, smaller spaces</td>
            <td class="compare-col-popular">Fastest heat, iconic barrel look</td>
            <td>Max interior space &amp; modern style</td>
            <td>Large groups &amp; entertaining</td>
          </tr>
          <tr>
            <td>Starting At</td>
            <td style="font-weight:700; color:#1a1a18;">Contact Us</td>
            <td class="compare-col-popular" style="font-weight:700; color:#1a1a18;">Contact Us</td>
            <td style="font-weight:700; color:#1a1a18;">Contact Us</td>
            <td style="font-weight:700; color:#1a1a18;">Contact Us</td>
          </tr>
          <tr>
            <td></td>
            <td><a href="/collections/viking-saunas" class="compare-btn">Shop Leif</a></td>
            <td class="compare-col-popular"><a href="/collections/viking-saunas" class="compare-btn compare-btn-popular">Shop Ragnar</a></td>
            <td><a href="/collections/viking-saunas" class="compare-btn">Shop Erik</a></td>
            <td><a href="/collections/viking-saunas" class="compare-btn">Shop Bjorn</a></td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Sauna Comparison",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Sauna Comparison" }]
}
{% endschema %}
