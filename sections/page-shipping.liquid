  }
  .shipping-updated {
    font-size: 0.85rem;
    color: #999;
    margin-bottom: 40px;
    display: block;
  }
  .shipping-intro {
    font-size: 1.05rem;
    color: #444;
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid #ebebeb;
  }
  .shipping-section {
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid #ebebeb;
  }
  .shipping-section:last-child {
    border-bottom: none;
  }
  .shipping-section h2 {
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
