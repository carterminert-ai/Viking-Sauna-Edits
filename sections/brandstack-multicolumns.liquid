{% endcomment %}
{%- style -%}
    .section-{{ section.id }}-padding { background: {{ section.settings.section_color }}; padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px }
    /* === BG IMAGE OPTIONS (ADD) === */
.section-{{ section.id }}-padding { position: relative; }

/* Only emit these styles when an image is set */
{% if section.settings.bg_image != blank %}
  .section-{{ section.id }}-padding {
    /* keep your existing background color; just add the image */
    background-image: url('{{ section.settings.bg_image | image_url }}');
    background-repeat: no-repeat;
    background-position: center center;
    {% if section.settings.bg_display_mode == 'full' %}
      /* Show the entire image across the section width */
      background-size: contain;
    {% else %}
      /* Natural (behaves like a hero) */
      background-size: cover;
    {% endif %}
  }

  {% if section.settings.bg_display_mode == 'full' %}
    /* Spacer ensures the whole image is visible even if there’s little content */
    .section-{{ section.id }}-padding::before {
      content: "";
      display: block;
      width: 100%;
      /* height = width / aspect_ratio; default fallback = 2 */
      padding-top: calc(100% / {{ section.settings.bg_image.aspect_ratio | default: 2 }});
    }
  {% endif %}
{% endif %}
/* === /BG IMAGE OPTIONS (ADD) === */
    .section-{{ section.id }}-padding .mcl-wrapper { display: flex; flex-wrap: wrap; justify-content: {{ section.settings.alignment }}; gap: {{ section.settings.space }}px; background: {{ section.settings.section_inside_color }}; border-radius: {{ section.settings.section_inside_radius }}px; border: {{ section.settings.section_inside_thikness }}px solid {{ section.settings.section_inside_border }}; padding: {{ section.settings.padding_top_bottom }}px {{ section.settings.padding_left_right }}px }
    .section-{{ section.id }}-padding .mcl-column { width: 100%; padding: 12px 15px; border-radius: {{ section.settings.border_radius }}px }
    .multicolumn--custom .mcl-column * { color: inherit }
    .multicolumn--custom .mcl-column h2, .multicolumn--custom .mcl-column h3, .multicolumn--custom .mcl-column h4, .multicolumn--custom .mcl-column h5, .multicolumn--custom .mcl-column h6, .multicolumn--custom .mcl-column p, .multicolumn--custom .mcl-column div { display: block; width: 100% }

    {% if section.settings.full_width == true %}
        .section-{{ section.id }}-padding .page-width { width: 100%; max-width: 100%; padding: 0 }
    {% endif %}
    
    @media screen and ( min-width: 768px ) {
        .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px }
        .multicolumn--custom .cwf--item-single .image--has-image .cwf-image-2 { opacity: 0; position: absolute; left: 0; top: 0; right: 0 }
        {% if section.settings.hide_desktop == true %}
            .section-{{ section.id }}-padding { display: none }
        {% endif %}
        .multicolumn--custom .swipe-text { display: none !important }
    }

    @media screen and ( max-width: 767px ) {
        {% if section.settings.hide_mobile == true %}
            .section-{{ section.id }}-padding { display: none }
        {% endif %}
        .multicolumn--custom .mcl-column { max-width: 100% !important }
        .section-{{ section.id }}-padding .mcl-wrapper { gap: {{ section.settings.space_mob }}px; padding: {{ section.settings.padding_top_bottom_mob }}px {{ section.settings.padding_left_right_mob }}px }
        main { overflow: hidden }
    }
{%- endstyle -%}

<section class="multicolumn--custom section-{{ section.id }}-padding">
    <div class="isolate page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="mcl-wrapper">
            {%- for block in section.blocks -%}
                <div class="mcl-column {% if block.settings.stack_mobile %}mcl--stack-mobile{% endif %}" id="mcl-column-{{ block.id }}" {{ block.shopify_attributes }}>
                    <style>
                        #mcl-column-{{ block.id }} { background: {{ block.settings.background }}; max-width: calc( {{ block.settings.width }}% - {{ section.settings.space }}px ); color: {{ block.settings.color }} }
                        #mcl-column-{{ block.id }} { display: flex; align-items: {{ block.settings.block_align }} }
                        #mcl-column-{{ block.id }} .mcl--inner { display: flex; align-items: center; width: 100%; flex-wrap: wrap }
                        #mcl-column-{{ block.id }} center { width: 100% }

                        #mcl-column-{{ block.id }} .mcl--inner-split { flex-wrap: nowrap; gap: {{ block.settings.column_gap }}px }
                        #mcl-column-{{ block.id }} .mcl--inner-split img { max-width: 100% }
                        #mcl-column-{{ block.id }} .mcl--inner-split > * { align-self: {{ block.settings.block_align }} }

                        @media screen and ( min-width: 768px ) {
                            {% if block.settings.hide_desktop == true %}
                                #mcl-column-{{ block.id }} { display: none }
                            {% endif %}

                            #mcl-column-{{ block.id }} .mcl--inner { text-align: {{ block.settings.block_alignment }} }

                            {% if block.settings.block_alignment == 'left' %}
                            #mcl-column-{{ block.id }} .mcl--inner * { margin-right: auto }
                            {% elsif block.settings.block_alignment == 'right' %}
                            #mcl-column-{{ block.id }} .mcl--inner * { margin-left: auto }
                            {% else %}
                            #mcl-column-{{ block.id }} .mcl--inner * { margin-left: auto; margin-right: auto }
                            {% endif %}
                        }
                        @media screen and ( max-width: 767px ) {
                            {% if block.settings.hide_mobile == true %}
                                #mcl-column-{{ block.id }} { display: none }
                            {% endif %}

                            {% if block.settings.stack_mobile == true %}
                                #mcl-column-{{ block.id }} .mcl--inner-split { flex-wrap: wrap; gap: {{ block.settings.column_gap_mobile }}px }
                                #mcl-column-{{ block.id }} .mcl--inner-split .mcl--split { width: 100% }
                            {% endif %}

                            #mcl-column-{{ block.id }} .mcl--inner { text-align: {{ block.settings.alignment_mobile }} }

                            {% if block.settings.alignment_mobile == 'left' %}
                            #mcl-column-{{ block.id }} .mcl--inner * { margin-right: auto }
                            {% elsif block.settings.alignment_mobile == 'right' %}
                            #mcl-column-{{ block.id }} .mcl--inner * { margin-left: auto }
                            {% else %}
                            #mcl-column-{{ block.id }} .mcl--inner * { margin-left: auto; margin-right: auto }
                            {% endif %}
                        }
                    </style>
                    {% if block.type == 'split_block' %}
                        <div class="mcl--inner mcl--inner-split">
                            <div class="mcl--split mcl--split-1">{{ block.settings.custom_liquid_1 }}</div>
                            <div class="mcl--split mcl--split-2">{{ block.settings.custom_liquid_2 }}</div>
                        </div>
                    {% elsif block.type == 'tri_block' %}
                        <div class="mcl--inner mcl--inner-split mcl--inner-tri">
                            <div class="mcl--split mcl--split-1">{{ block.settings.custom_liquid_1 }}</div>
                            <div class="mcl--split mcl--split-2">{{ block.settings.custom_liquid_2 }}</div>
                            <div class="mcl--split mcl--split-3">{{ block.settings.custom_liquid_3 }}</div>
                        </div>
                    {% elsif block.type == 'two_plus_one_block' %}
                    {% if block.settings.stack_mobile %}
  <style>
    @media screen and (max-width: 767px) {
      #mcl-column-{{ block.id }} .mcl--2-1-top {
        flex-wrap: wrap !important;
      }
      #mcl-column-{{ block.id }} .mcl--2-1-top > .mcl--split {
        width: 100% !important;
      }
    }
  </style>
{% endif %}
<div class="mcl--inner mcl--inner-2-1" style="width: 100%;">
  {% if block.settings.block_order == 'two-over-one' %}
    <div class="mcl--2-1-top" style="display: flex; width: 100%; gap: {{ block.settings.column_gap }}px;">
      <div class="mcl--split mcl--split-1" style="width: 50%;">{{ block.settings.custom_liquid_1 }}</div>
      <div class="mcl--split mcl--split-2" style="width: 50%;">{{ block.settings.custom_liquid_2 }}</div>
    </div>
    <div class="mcl--2-1-bottom" style="width: 100%; margin-top: {{ block.settings.column_gap }}px;">
      <div class="mcl--split mcl--split-3" style="width: 100%;">{{ block.settings.custom_liquid_3 }}</div>
    </div>
  {% else %}
    <div class="mcl--2-1-bottom" style="width: 100%; margin-bottom: {{ block.settings.column_gap }}px;">
      <div class="mcl--split mcl--split-3" style="width: 100%;">{{ block.settings.custom_liquid_3 }}</div>
    </div>
    <div class="mcl--2-1-top" style="display: flex; width: 100%; gap: {{ block.settings.column_gap }}px;">
      <div class="mcl--split mcl--split-1" style="width: 50%;">{{ block.settings.custom_liquid_1 }}</div>
      <div class="mcl--split mcl--split-2" style="width: 50%;">{{ block.settings.custom_liquid_2 }}</div>
    </div>
  {% endif %}
</div>
                    {% elsif block.type == 'quad_block' %}
                        <div class="mcl--inner mcl--inner-split mcl--inner-tri">
                            <div class="mcl--split mcl--split-1">{{ block.settings.custom_liquid_1 }}</div>
                            <div class="mcl--split mcl--split-2">{{ block.settings.custom_liquid_2 }}</div>
                            <div class="mcl--split mcl--split-3">{{ block.settings.custom_liquid_3 }}</div>
                            <div class="mcl--split mcl--split-4">{{ block.settings.custom_liquid_4 }}</div>
                        </div>
                    {% elsif block.type == 'fifth_block' %}
                        <div class="mcl--inner mcl--inner-split mcl--inner-tri">
                            <div class="mcl--split mcl--split-1">{{ block.settings.custom_liquid_1 }}</div>
                            <div class="mcl--split mcl--split-2">{{ block.settings.custom_liquid_2 }}</div>
                            <div class="mcl--split mcl--split-3">{{ block.settings.custom_liquid_3 }}</div>
                            <div class="mcl--split mcl--split-4">{{ block.settings.custom_liquid_4 }}</div>
                            <div class="mcl--split mcl--split-5">{{ block.settings.custom_liquid_5 }}</div>
                        </div>
                    {% else %}
                        <div class="mcl--inner">{{ block.settings.custom_liquid }}</div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>

