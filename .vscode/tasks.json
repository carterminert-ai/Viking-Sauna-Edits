{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Commit and Push",
      "type": "shell",
      "command": "git add -A && git commit -m 'Update' && git pull --rebase origin main && git push",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
