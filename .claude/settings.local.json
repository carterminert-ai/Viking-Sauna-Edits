{
  "permissions": {
    "allow": [
      "Skill(update-config)",
      "Skill(update-config:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git push",
            "if": "Bash(git commit*)",
            "shell": "powershell",
            "statusMessage": "Pushing to remote..."
          }
        ]
      }
    ]
  }
}
